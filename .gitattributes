# Opis: README.md, sekcja "Jak git traktuje pliki"

# --- Końce linii ---
* text=auto

# Kod i pliki tekstowe
*.cs            text diff=csharp
*.shader        text
*.hlsl          text
*.cginc         text
*.shadergraph   text
*.json          text
*.inputactions  text
*.uxml          text
*.uss           text
*.tss           text
*.xsd           text
*.md            text
*.yml           text
*.sh            text eol=lf

# --- Pliki YAML Unity: LF + Smart Merge ---
*.unity         text eol=lf merge=unityyamlmerge
*.prefab        text eol=lf merge=unityyamlmerge
*.asset         text eol=lf merge=unityyamlmerge
*.mat           text eol=lf merge=unityyamlmerge
*.anim          text eol=lf merge=unityyamlmerge
*.controller    text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.mask          text eol=lf merge=unityyamlmerge
*.mixer         text eol=lf merge=unityyamlmerge
*.playable      text eol=lf merge=unityyamlmerge
*.physicMaterial text eol=lf merge=unityyamlmerge
*.lighting      text eol=lf merge=unityyamlmerge
*.meta          text eol=lf merge=unityyamlmerge

# --- Binarne przez Git LFS ---
# Nawiasy łapią obie wielkości liter (.ttf i .TTF). Na Windowsie git i tak ich nie rozróżnia,
# ale na Linuksie (CI) i macOS samo *.ttf nie objęłoby pliku .TTF.
# Grafika
*.[pP][nN][gG]         filter=lfs diff=lfs merge=lfs -text
*.[jJ][pP][gG]         filter=lfs diff=lfs merge=lfs -text
*.[jJ][pP][eE][gG]     filter=lfs diff=lfs merge=lfs -text
*.[pP][sS][dD]         filter=lfs diff=lfs merge=lfs -text
*.[tT][gG][aA]         filter=lfs diff=lfs merge=lfs -text
*.[tT][iI][fF]         filter=lfs diff=lfs merge=lfs -text
*.[tT][iI][fF][fF]     filter=lfs diff=lfs merge=lfs -text
*.[eE][xX][rR]         filter=lfs diff=lfs merge=lfs -text
*.[hH][dD][rR]         filter=lfs diff=lfs merge=lfs -text
*.[kK][rR][aA]         filter=lfs diff=lfs merge=lfs -text
*.[aA][sS][eE][pP][rR][iI][tT][eE] filter=lfs diff=lfs merge=lfs -text
# Dźwięk
*.[wW][aA][vV]         filter=lfs diff=lfs merge=lfs -text
*.[mM][pP]3            filter=lfs diff=lfs merge=lfs -text
*.[oO][gG][gG]         filter=lfs diff=lfs merge=lfs -text
*.[fF][lL][aA][cC]     filter=lfs diff=lfs merge=lfs -text
# Modele
*.[fF][bB][xX]         filter=lfs diff=lfs merge=lfs -text
*.[oO][bB][jJ]         filter=lfs diff=lfs merge=lfs -text
*.[bB][lL][eE][nN][dD] filter=lfs diff=lfs merge=lfs -text
# Wideo
*.[mM][pP]4            filter=lfs diff=lfs merge=lfs -text
*.[wW][eE][bB][mM]     filter=lfs diff=lfs merge=lfs -text
# Czcionki
*.[tT][tT][fF]         filter=lfs diff=lfs merge=lfs -text
*.[oO][tT][fF]         filter=lfs diff=lfs merge=lfs -text
# Inne
*.[dD][lL][lL]         filter=lfs diff=lfs merge=lfs -text
*.[zZ][iI][pP]         filter=lfs diff=lfs merge=lfs -text

# Wypiekane światło jest binarne mimo rozszerzenia .asset (późniejsza reguła wygrywa)
LightingData.asset filter=lfs diff=lfs merge=lfs -text
